#!/usr/bin/env bash
# Builds the Android app for a release tag and attaches it to that GitHub
# release, for renoa-deploy to place where renoa.live serves app updates.
#
#   scripts/publish-android-app v0.16.0
#
# Until the app has a release key, it ships the debug build, signed with the
# debug key of the machine it runs on: the key the owner's phone already trusts.
# Run it on that machine, from a clean checkout of the tag, after the release
# workflow has published the release; another machine's key would make every
# phone refuse the update. Publish before `renoa-deploy install <tag>`, or run
# that install again afterwards to serve the app. It adds
# renoa-<tag>-android.apk and renoa-<tag>-android.json (version code, version
# name, digest and size) and lists both in the release's SHA256SUMS. Publishing
# again replaces them.
set -euo pipefail

tag=${1:?usage: scripts/publish-android-app <tag>}
[[ $tag =~ ^v([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})$ ]] || { echo "a release tag is vMAJOR.MINOR.PATCH, not $tag" >&2; exit 2; }
version=${BASH_REMATCH[1]}

cd "$(dirname "$0")/.."
[[ $(git rev-parse HEAD) == $(git rev-parse "$tag^{commit}") ]] || { echo "check out $tag first" >&2; exit 2; }
[[ -z $(git status --porcelain --untracked-files=no) ]] || { echo "the checkout has changes; publish from a clean $tag" >&2; exit 2; }

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
gh release download "$tag" --pattern SHA256SUMS --dir "$out"

(cd clients/android && ./gradlew -q "-Prenoa.version=$version" :app:assembleDebug)
built=clients/android/app/build/outputs/apk/debug
apk=$out/renoa-$tag-android.apk
described=$out/renoa-$tag-android.json
cp "$built/app-debug.apk" "$apk"

python3 - "$built/output-metadata.json" "$apk" "$described" "$version" <<'PY'
import hashlib, json, os, sys
metadata, apk, described, version = sys.argv[1:]
element = json.load(open(metadata))["elements"][0]
if element["versionName"] != version:
    sys.exit(f"built version {element['versionName']}, expected {version}")
digest = hashlib.sha256(open(apk, "rb").read()).hexdigest()
info = {"version_code": element["versionCode"], "version_name": version, "sha256": digest, "size": os.path.getsize(apk)}
open(described, "w").write(json.dumps(info, indent=2) + "\n")
PY

grep -v -F -e "renoa-$tag-android.apk" -e "renoa-$tag-android.json" "$out/SHA256SUMS" > "$out/SHA256SUMS.new" || true
(cd "$out" && shasum -a 256 "renoa-$tag-android.apk" "renoa-$tag-android.json") >> "$out/SHA256SUMS.new"
mv "$out/SHA256SUMS.new" "$out/SHA256SUMS"
gh release upload "$tag" "$apk" "$described" "$out/SHA256SUMS" --clobber
echo "published the app $version for $tag"
