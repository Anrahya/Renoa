#!/usr/bin/env bash
# Builds the Mac app for a release tag and attaches it to that GitHub release,
# for renoa-deploy to place where renoa.live serves app updates.
#
#   scripts/publish-mac-app v0.23.0
#
# The app is signed with the owner's "Renoa Dev" identity, and an installed
# app takes an update only when the same key signed it (clients/mac/src/update.rs),
# so run it on the Mac that holds that identity, from a clean checkout of the
# tag, after the release workflow has published the release. Publish before
# `renoa-deploy install <tag>`, or run that install again afterwards to serve
# the app. It adds renoa-<tag>-mac.zip and renoa-<tag>-mac.json (version,
# digest and size) and lists both in the release's SHA256SUMS. Publishing again
# replaces them.
set -euo pipefail

tag=${1:?usage: scripts/publish-mac-app <tag>}
[[ $tag =~ ^v([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})$ ]] || { echo "a release tag is vMAJOR.MINOR.PATCH, not $tag" >&2; exit 2; }
version=${BASH_REMATCH[1]}

cd "$(dirname "$0")/.."
[[ $(git rev-parse HEAD) == $(git rev-parse "$tag^{commit}") ]] || { echo "check out $tag first" >&2; exit 2; }
[[ -z $(git status --porcelain --untracked-files=no) ]] || { echo "the checkout has changes; publish from a clean $tag" >&2; exit 2; }

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
gh release download "$tag" --pattern SHA256SUMS --dir "$out"

RENOA_VERSION=$version clients/mac/scripts/bundle-app.sh "$out/build"
codesign --display --requirements - "$out/build/Renoa.app" 2>&1 | grep -q 'certificate leaf' \
    || { echo "Renoa.app is not signed with the \"Renoa Dev\" identity; an installed app would refuse it" >&2; exit 2; }
zip=$out/renoa-$tag-mac.zip
described=$out/renoa-$tag-mac.json
ditto -c -k --keepParent "$out/build/Renoa.app" "$zip"

python3 - "$zip" "$described" "$version" <<'PY'
import hashlib, json, os, sys
zipped, described, version = sys.argv[1:]
digest = hashlib.sha256(open(zipped, "rb").read()).hexdigest()
info = {"version_name": version, "sha256": digest, "size": os.path.getsize(zipped)}
open(described, "w").write(json.dumps(info, indent=2) + "\n")
PY

grep -v -F -e "renoa-$tag-mac.zip" -e "renoa-$tag-mac.json" "$out/SHA256SUMS" > "$out/SHA256SUMS.new" || true
(cd "$out" && shasum -a 256 "renoa-$tag-mac.zip" "renoa-$tag-mac.json") >> "$out/SHA256SUMS.new"
mv "$out/SHA256SUMS.new" "$out/SHA256SUMS"
gh release upload "$tag" "$zip" "$described" "$out/SHA256SUMS" --clobber
echo "published the Mac app $version for $tag"
