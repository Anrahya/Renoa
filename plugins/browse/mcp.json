{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "browse": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@opencode/browse@0.1.5", "mcp"],
      "env": {
        "OPENCODE_BROWSER_AUTO_UPDATE": "off",
        "OPENCODE_BROWSER_HOME": "${PLUGIN_DATA}/browse",
        "npm_config_cache": "${PLUGIN_DATA}/npm",
        "npm_config_update_notifier": "false"
      }
    }
  }
}
