<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hearing that a network came up, so a reconnect need not wait out its backoff. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Holding the chat's low-latency Wi-Fi lock. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Telling the owner an agent answered while the app was closed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Handing a downloaded update to the phone's installer, which asks the owner first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".RenoaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Renoa">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A notice's tap: not exported, so only this app's notices can open a chat. -->
        <activity
            android:name=".push.NoticeTap"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Where the camera app saves a photo the owner takes to send an agent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>
        <!-- Renoa's wake-ups and new push tokens, from Firebase Cloud Messaging. -->
        <service
            android:name=".push.PushMessages"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
