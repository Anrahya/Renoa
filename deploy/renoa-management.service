[Unit]
Description=Renoa personal Host control panel
After=network-online.target renoa-coordinator.service
Wants=network-online.target

[Service]
Type=simple
User=renoa-arcee
Group=renoa-arcee
LoadCredential=config:/home/renoa/.renoa/config/management.json
ExecStart=/usr/local/bin/renoa-management %d/config
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Owner creation, schedules, and Discord bindings use the canonical Host home.
Environment=HOME=/home/renoa
ReadWritePaths=/home/renoa/.renoa
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
