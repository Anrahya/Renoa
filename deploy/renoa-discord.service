[Unit]
Description=Renoa Discord surface
After=network-online.target renoa-coordinator.service
Wants=network-online.target
ConditionPathExists=/home/renoa/.renoa/config/discord.json
ConditionPathExists=/home/renoa/.renoa/credentials/discord.json
ConditionPathExists=/home/renoa/.renoa/credentials/discord-rcp-device.json

[Service]
Type=simple
User=renoa-arcee
Group=renoa-arcee
Environment=HOME=/home/renoa
WorkingDirectory=/home/renoa/.renoa
LoadCredential=config:/home/renoa/.renoa/config/discord.json
ExecStart=/usr/local/bin/renoa-discord %d/config
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/renoa/.renoa
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
