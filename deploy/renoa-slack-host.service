[Unit]
Description=Renoa Arcee Slack surface on the shared VPS Host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=renoa-arcee
Group=renoa-arcee
StateDirectory=renoa-telegram
StateDirectoryMode=0700
WorkingDirectory=/srv/renoa/arcee
Environment=HOME=/var/lib/renoa-telegram
Environment=TZ=Asia/Kolkata
LoadCredential=slack-bot-token:/etc/renoa/slack-bot-token
LoadCredential=slack-app-token:/etc/renoa/slack-app-token
LoadCredential=oauth-relay-device:/etc/renoa/arcee-oauth-relay-device
LoadCredential=slack-config:/etc/renoa/slack.json
UMask=0077
ExecStart=/usr/local/bin/renoa-slack run %d/slack-config
Restart=on-failure
RestartSec=10s
TimeoutStopSec=90s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/srv/renoa/arcee
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
