{
  "binaries": [
    { "package": "renoa-control", "bin": "renoa-coordinator" },
    { "package": "renoa-registry", "bin": "renoa-registry" },
    { "package": "renoa-local", "bin": "renoa-host" },
    { "package": "renoa-node", "bin": "renoa-node" },
    { "package": "renoa-discord", "bin": "renoa-discord" }
  ],
  "adapters": ["mcp-client-node", "mcp-registry-node", "model-provider-node"],
  "services": [
    { "unit": "renoa-coordinator.service", "binaries": ["renoa-coordinator"] },
    { "unit": "renoa-registry.service", "binaries": ["renoa-registry"] },
    { "unit": "renoa-node.service", "binaries": ["renoa-node"], "adapters": true },
    {
      "unit": "renoa-discord.service",
      "binaries": ["renoa-discord"],
      "companion_units": ["renoa-discord.path"]
    }
  ]
}
