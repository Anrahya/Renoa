[Unit]
Description=Renoa Arcee Telegram surface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=renoa-arcee
Group=renoa-arcee
StateDirectory=renoa-telegram
StateDirectoryMode=0700
WorkingDirectory=/srv/renoa/arcee
Environment=HOME=/var/lib/renoa-telegram
Environment=RENOA_DATA_DIR=/var/lib/renoa-telegram
Environment=RENOA_TELEGRAM_WORKSPACE=/srv/renoa/arcee
Environment=RENOA_TELEGRAM_BOT_TOKEN_FILE=%d/telegram-bot-token
Environment=RENOA_TELEGRAM_IPV4_ONLY=1
Environment=RENOA_OAUTH_RELAY_ORIGIN=https://renoa.live
Environment=RENOA_OAUTH_RELAY_DEVICE_CREDENTIAL_FILE=%d/oauth-relay-device
EnvironmentFile=/etc/renoa/telegram.env
LoadCredential=telegram-bot-token:/etc/renoa/telegram-bot-token
LoadCredential=oauth-relay-device:/etc/renoa/arcee-oauth-relay-device
UMask=0077
ExecStart=/usr/local/bin/renoa-telegram
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/srv/renoa/arcee
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
