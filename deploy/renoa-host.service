[Unit]
Description=Renoa Host routine scheduler and runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=renoa-arcee
Group=renoa-arcee
Environment=HOME=/home/renoa
LoadCredential=host-config:/home/renoa/.renoa/config/host.json
LoadCredential=oauth-relay-device:/home/renoa/.renoa/credentials/oauth-relay-device
ExecStart=/usr/local/bin/renoa-host %d/host-config
Restart=on-failure
RestartSec=10
TimeoutStopSec=300
UMask=0077

[Install]
WantedBy=multi-user.target
