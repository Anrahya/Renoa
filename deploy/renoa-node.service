[Unit]
Description=Renoa RCP execution node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=renoa-node
Group=renoa-node
StateDirectory=renoa-node
StateDirectoryMode=0700
WorkingDirectory=/srv/renoa/node-workspaces
Environment=HOME=/var/lib/renoa-node
LoadCredential=node-config:/etc/renoa/node.json
LoadCredential=rcp-device:/etc/renoa/node-device.json
UMask=0077
ExecStart=/usr/local/bin/renoa-node serve %d/node-config %d/rcp-device /var/lib/renoa-node
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/srv/renoa/node-workspaces
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
