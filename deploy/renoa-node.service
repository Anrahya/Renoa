[Unit]
Description=Renoa RCP execution node for the shared Host
After=network-online.target renoa-coordinator.service
Wants=network-online.target

[Service]
Type=simple
User=renoa-arcee
Group=renoa-arcee
Environment=HOME=/home/renoa
Environment=TZ=Asia/Kolkata
WorkingDirectory=/home/renoa/.renoa
LoadCredential=node-config:/home/renoa/.renoa/config/node.json
LoadCredential=rcp-device:/home/renoa/.renoa/credentials/node-device.json
UMask=0077
ExecStart=/usr/local/bin/renoa-node serve %d/node-config %d/rcp-device /home/renoa/.renoa
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/renoa/.renoa
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
