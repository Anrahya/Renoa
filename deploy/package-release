#!/usr/bin/env python3
"""Build one Renoa release archive from this checkout.

    deploy/package-release <tag> <output-directory>

Builds the binaries, Node adapters and Control Room named in
deploy/release.json and writes renoa-<tag>-linux-x86_64.tar.gz with its
release.json manifest, plus SHA256SUMS. CI runs it in a Debian 13 container, so
the binaries link against the same glibc as the VPS.
"""

import hashlib
import json
import os
import shutil
import subprocess
import sys
import tarfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DEFINITION = json.loads((ROOT / "deploy" / "release.json").read_text())


def run(*args: str, cwd: Path = ROOT) -> None:
    print("+", " ".join(args), flush=True)
    subprocess.run(args, cwd=cwd, check=True)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def build_binaries(stage: Path) -> dict[str, str]:
    arguments = ["cargo", "build", "--locked", "--release"]
    for binary in DEFINITION["binaries"]:
        arguments += ["-p", binary["package"], "--bin", binary["bin"]]
    run(*arguments)
    (stage / "bin").mkdir()
    binaries = {}
    for binary in DEFINITION["binaries"]:
        target = stage / "bin" / binary["bin"]
        shutil.copy2(ROOT / "target" / "release" / binary["bin"], target)
        binaries[binary["bin"]] = sha256(target)
    return binaries


def build_adapters(stage: Path) -> None:
    for adapter in DEFINITION["adapters"]:
        source = ROOT / "adapters" / adapter
        run("pnpm", "install", "--frozen-lockfile", cwd=source)
        run("pnpm", "run", "build", cwd=source)
        target = stage / "adapters" / adapter
        target.mkdir(parents=True)
        for name in ("package.json", "pnpm-lock.yaml"):
            shutil.copy2(source / name, target / name)
        shutil.copytree(source / "dist" / "src", target / "dist" / "src")
        # Production dependencies only, as plain directories without links.
        run(
            "pnpm", "install", "--prod", "--frozen-lockfile", "--ignore-scripts",
            "--config.node-linker=hoisted", cwd=target,
        )


def build_control_room(stage: Path) -> None:
    source = ROOT / "surfaces" / "control-room"
    run("npm", "ci", cwd=source)
    run("npm", "run", "build", cwd=source)
    shutil.copytree(source / "dist" / "client", stage / "control-room")


def copy_units(stage: Path) -> None:
    (stage / "units").mkdir()
    for service in DEFINITION["services"]:
        for unit in [service["unit"], *service.get("companion_units", [])]:
            shutil.copy2(ROOT / "deploy" / unit, stage / "units" / unit)


def commit() -> str:
    return os.environ.get("GITHUB_SHA") or subprocess.run(
        ["git", "rev-parse", "HEAD"], cwd=ROOT, capture_output=True, text=True, check=True
    ).stdout.strip()


def main(tag: str, output: Path) -> None:
    name = f"renoa-{tag}"
    work = output / name
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True)
    binaries = build_binaries(work)
    build_adapters(work)
    build_control_room(work)
    copy_units(work)
    shutil.copy2(ROOT / "deploy" / "renoa-deploy", work / "renoa-deploy")
    manifest = {
        "tag": tag,
        "commit": commit(),
        "built_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "binaries": binaries,
        "adapters": DEFINITION["adapters"],
        "services": DEFINITION["services"],
    }
    (work / "release.json").write_text(json.dumps(manifest, indent=2) + "\n")
    archive = output / f"{name}-linux-x86_64.tar.gz"
    with tarfile.open(archive, "w:gz") as bundle:
        bundle.add(work, arcname=name)
    shutil.rmtree(work)
    (output / "SHA256SUMS").write_text(f"{sha256(archive)}  {archive.name}\n")
    print(f"wrote {archive}")


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    main(sys.argv[1], Path(sys.argv[2]).resolve())
